{
  "name": "whatsapp-mcp",
  "version": "1.0.0",
  "main": "src/main.ts",
  "type": "module",
  "keywords": [
    "whatsapp",
    "mcp",
    "baileys",
    "claude"
  ],
  "author": "AmiticIA-AutoSys",
  "license": "MIT",
  "description": "WhatsApp MCP server using Baileys for Claude/Cursor integration",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmiticIA-AutoSys/whatsapp-mcp.git"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "postinstall": "prisma generate || true"
  },
  "dependencies": {
    "@amiticia/baileys-client": "link:../baileys-client",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastmcp": "^4.0.0",
    "minio": "^8.0.2",
    "p-limit": "^7.3.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testcontainers/minio": "^10.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "prisma": "^7.7.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=23.10.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
