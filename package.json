{
  "name": "whatsapp-mcp",
  "version": "1.0.0",
  "main": "src/main.ts",
  "type": "module",
  "keywords": [
    "whatsapp",
    "mcp",
    "baileys",
    "claude"
  ],
  "author": "AmiticIA-AutoSys",
  "license": "MIT",
  "description": "WhatsApp MCP server using Baileys for Claude/Cursor integration",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmiticIA-AutoSys/whatsapp-mcp.git"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:harness": "node --test \"scripts/lib/*.test.mjs\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "quality-gate": "node scripts/quality-gate.mjs",
    "quality-gate:update": "node scripts/quality-gate.mjs --update-baseline",
    "dispatch": "bash scripts/dispatch-worktree.sh",
    "dispatch:cleanup": "bash scripts/cleanup-worktrees.sh",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@amiticia/baileys-client": "link:../baileys-client",
    "@google/genai": "^2.6.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^12.9.0",
    "drizzle-orm": "^0.45.2",
    "fastmcp": "^4.0.0",
    "minio": "^8.0.2",
    "p-limit": "^7.3.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@testcontainers/minio": "^10.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jscpd": "^5.0.12",
    "knip": "^6.29.0",
    "lint-staged": "^17.1.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.33.2"
}
