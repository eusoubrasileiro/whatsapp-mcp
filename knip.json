{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.ts",
    "src/__tests__/**/*.test.ts",
    "scripts/**/*.mjs",
    "e2e/**/*.e2e.test.ts",
    "e2e/support/serve.ts"
  ],
  "project": ["src/**/*.ts", "scripts/**/*.mjs", "e2e/**/*.ts"],
  "ignore": ["src/db/schema.ts"],
  "ignoreDependencies": ["@amiticia/baileys-client"],
  "ignoreBinaries": ["biome"]
}
