set -e

# Read all pushed refs from stdin (can only be read once).
# Each line: <local_ref> <local_sha> <remote_ref> <remote_sha>
# A deletion is signaled by local_sha == 40 zeros.
# When we find a real push, capture the SHAs so the security reviewer
# (scripts/security-review.mjs) can diff the exact range being pushed.
stdin_data="$(cat)"

zero_sha="0000000000000000000000000000000000000000"
has_real_push=0
PUSH_LOCAL_SHA=""
PUSH_REMOTE_SHA=""
PUSH_REMOTE_REF=""

if [ -n "$stdin_data" ]; then
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    local_sha="$(printf '%s' "$line" | awk '{print $2}')"
    if [ "$local_sha" != "$zero_sha" ]; then
      has_real_push=1
      PUSH_LOCAL_SHA="$local_sha"
      PUSH_REMOTE_REF="$(printf '%s' "$line" | awk '{print $3}')"
      PUSH_REMOTE_SHA="$(printf '%s' "$line" | awk '{print $4}')"
      break
    fi
  done <<EOF
$stdin_data
EOF
fi

if [ "$has_real_push" -eq 0 ]; then
  echo "[pre-push] delete-only push, skipping heavy gate"
  exit 0
fi

export PUSH_LOCAL_SHA PUSH_REMOTE_SHA PUSH_REMOTE_REF

# Heavy gate (full safety net before code leaves the machine). Stages:
#   1. tsc --noEmit    — full typecheck
#   2. pnpm lint       — biome, zero tolerance
#   3. test:coverage   — full suite + coverage for the quality gate
#   4. quality-gate    — deterministic metrics ratchet   (armed in its commit)
#   5. security-review — Sonnet LLM reviewer, fail-closed (armed in its commit)
#   6. show-review-log — print every verdict in the pushed range for eyeballing
#
# Stages 4-6 are added as their scripts land. There is no e2e/Playwright block:
# this is a single MCP server, not a web app.
pnpm exec tsc --noEmit
pnpm lint
pnpm test:coverage
