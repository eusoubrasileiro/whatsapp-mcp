#!/usr/bin/env sh
# Prints a one-line quality-gate delta summary. Never blocks a commit. (It once also
# backfilled a "(staged)" review-log entry with the NEW commit's hash, which mislabelled
# a pre-push verdict with a commit it never read; the reviewer now stamps each entry
# with the commit it reviewed — standards.md §5.)
node scripts/print-quality-delta.mjs 2>/dev/null || true
