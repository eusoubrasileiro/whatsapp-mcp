# Copy to .env alongside docker-compose.yaml and fill in before deploy.
# .env is gitignored. Do NOT commit real values.

# Public hostnames (Traefik routes + the URLs the app hands out). Required —
# `docker compose` refuses to start without them.
MCP_DOMAIN=mcp.example.com
QR_DOMAIN=wa.example.com

# Shared secret that MCP clients must send as: Authorization: Bearer <token>
# Generate with:  openssl rand -hex 32
MCP_AUTH_TOKEN=

# ntfy.sh topic (use a long random suffix to avoid stranger subscriptions)
NTFY_TOPIC_URL=https://ntfy.sh/CHANGE-ME-RANDOM-SUFFIX

# Optional — only if NTFY_TOPIC_URL points to a protected topic
NTFY_TOKEN=

# Phone prefix allowed to pair (e.g. 5531 for Minas Gerais). Required for safety:
# if a stranger scans the public QR, the app logs them out and purges auth_info.
EXPECTED_WA_NUMBER=

# ── Anti-ban policy — risk-owner settings, see docs/account-restrictions.md ────
# deny (the default when unset) makes the allow_cold_contact tool param inert.
# Set allow only on a disposable outreach number.
# SEND_COLD_OVERRIDE=deny
# Numbers you own that may always be messaged, comma-separated. Exact-string
# match: list every digit form you send to (e.g. both the 12- and 13-digit form).
# SEND_COLD_ALLOWED_JIDS=

# ── RustFS / S3 sidecar (this stack runs it) ──────────────────────────────────
# Required — docker-compose.yaml references these in 6 places (RUSTFS_ROOT_*,
# minio-init, S3_ACCESS_KEY/S3_SECRET_KEY). Without them `docker compose up`
# starts a RustFS with empty credentials and every media upload 403s.
# Generate with:  openssl rand -hex 16
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- AI features (download_media) ---
# One OpenRouter key powers both:
#   transcription — Whisper Large v3 (download_media transcribe=true)
#   image description — vision model (download_media describe=true)
OPENROUTER_API_KEY=

# Rollback lane. Leave UNSET for normal operation (defaults to openrouter).
# Setting it to groq/openai also requires that vendor's key below.
# AUDIO_PROVIDER=
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Image description model override (any OpenRouter image-input model id).
# VISION_MODEL=openai/gpt-6-luna
