# Shared stack (the hub page). Copy to .env alongside docker-compose.yaml and fill in before
# deploy. .env is gitignored. Do NOT commit real values.
# Each WhatsApp number has its own env file, and its own media store credentials: see
# instance.env.example.

# The one public hostname. Every number is reached at https://<this>/<label>/ and the hub
# page is https://<this>/. Required — `docker compose` refuses to start without it.
PUBLIC_DOMAIN=wa.example.com

# ── Hub page ───────────────────────────────────────────────────────────────────
# The PIN that opens the hub page: choose it; never commit it.
HUB_PIN=
# Signs the hub's session cookie. Generate with:  openssl rand -hex 32
HUB_COOKIE_KEY=
# Optional. Authenticates the hub's "unlink this number" call to a number; put the same
# value in every number's env file. Left empty, the hub offers no unlink (reading a
# number's status needs no secret). Generate with:  openssl rand -hex 32
# At least 32 characters: a shorter value stops the hub, and a number ignores it.
HUB_INSTANCE_SECRET=
# The numbers the hub lists, e.g. HUB_INSTANCES=pessoal,empresa
HUB_INSTANCES=
# Hub page language: en (default) or pt-BR, written exactly so. Any other value stops the hub.
HUB_LANG=en

# ntfy.sh topic (use a long random suffix to avoid stranger subscriptions)
NTFY_TOPIC_URL=https://ntfy.sh/CHANGE-ME-RANDOM-SUFFIX
# Optional — only if NTFY_TOPIC_URL points to a protected topic
NTFY_TOKEN=
