# Copy to .env alongside docker-compose.yaml and fill in before deploy.
# .env is gitignored. Do NOT commit real values.

# Shared secret that MCP clients must send as: Authorization: Bearer <token>
# Generate with:  openssl rand -hex 32
MCP_AUTH_TOKEN=

# ntfy.sh topic (use a long random suffix to avoid stranger subscriptions)
NTFY_TOPIC_URL=https://ntfy.sh/CHANGE-ME-RANDOM-SUFFIX

# Optional — only if NTFY_TOPIC_URL points to a protected topic
NTFY_TOKEN=

# Phone prefix allowed to pair (e.g. 5531 for Minas Gerais). Required for safety:
# if a stranger scans the public QR, the app logs them out and purges auth_info.
EXPECTED_WA_NUMBER=

# ── RustFS / S3 sidecar (this stack runs it) ──────────────────────────────────
# Required — docker-compose.yaml references these in 6 places (RUSTFS_ROOT_*,
# minio-init, S3_ACCESS_KEY/S3_SECRET_KEY). Without them `docker compose up`
# starts a RustFS with empty credentials and every media upload 403s.
# Generate with:  openssl rand -hex 16
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- AI features (download_media) ---
# Transcription: Whisper Large v3 via OpenRouter. Since 2026-08-24 OpenRouter is
# the only provider — the Groq and DeepInfra accounts were closed.
OPENROUTER_API_KEY=

# Rollback lane. Leave UNSET for normal operation (defaults to openrouter).
# Setting it to groq/openai also requires that vendor's key below.
# AUDIO_PROVIDER=
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Image description (download_media describe=true) — still Google direct.
GEMINI_API_KEY=
