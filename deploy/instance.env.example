# One WhatsApp number. Copy to .env.<label> (e.g. .env.empresa) alongside
# docker-compose.instance.yaml and fill in before deploy. Every .env.* file is gitignored.
# Do NOT commit real values. Start the number with:
#   docker compose --env-file .env.<label> up -d
# That starts the number's app and its own media store. The shared stack (docker-compose.yaml,
# .env.example) holds only the hub page; a number does not depend on it.

# Tells compose which file this env file is for. Leave as is.
COMPOSE_FILE=docker-compose.instance.yaml

# This number's label: lowercase letters, digits and hyphens. It becomes the URL path
# (https://<PUBLIC_DOMAIN>/<label>/mcp), the compose project and the container names. Do not
# give a number a label that is another number's label plus "-minio": the two would ask for
# the same container name, and Docker refuses the second.
INSTANCE=
# One line the hub shows next to the label (optional)
INSTANCE_DESCRIPTION=

# The one public hostname — the same as in the shared stack's .env. Required.
PUBLIC_DOMAIN=wa.example.com

# Shared secret that MCP clients must send as: Authorization: Bearer <token>
# One per number. Generate with:  openssl rand -hex 32
MCP_AUTH_TOKEN=

# The number allowed to pair. The full number lets the hub show its last 4 digits before
# pairing; a shorter prefix (e.g. 5531 for Minas Gerais) is still accepted. Required for
# safety: if any other number scans the QR, the app logs it out and purges auth_info.
EXPECTED_WA_NUMBER=

# Optional. Same value as HUB_INSTANCE_SECRET in the shared stack's .env: it lets the hub
# unlink this number. Left empty or shorter than 32 characters, this number has no such call.
HUB_INSTANCE_SECRET=

# ── Only for a number that already has data from the single-instance layout ───
# Uncomment both for that number, and for no other. Its pairing and archive stay in the
# directory they are in (no re-scan), and the media objects already written live under
# t/default/, so the tenant must stay "default" or the old links stop resolving. Its media
# store runs on <INSTANCE_DATA_DIR>/minio, where those objects are.
# INSTANCE_DATA_DIR=/storage/whatsapp-mcp
# TENANT_ID=default

# ntfy.sh topic (use a long random suffix to avoid stranger subscriptions)
NTFY_TOPIC_URL=https://ntfy.sh/CHANGE-ME-RANDOM-SUFFIX

# Optional — only if NTFY_TOPIC_URL points to a protected topic
NTFY_TOKEN=

# ── Anti-ban policy — risk-owner settings, see docs/account-restrictions.md ────
# deny (the default when unset) makes the allow_cold_contact tool param inert.
# Set allow only on a disposable outreach number.
# SEND_COLD_OVERRIDE=deny
# Numbers you own that may always be messaged, comma-separated. Exact-string
# match: list every digit form you send to (e.g. both the 12- and 13-digit form).
# SEND_COLD_ALLOWED_JIDS=

# ── This number's own media store (RustFS) ────────────────────────────────────
# Required, and this number's own pair: a different one for every number, never copied
# between env files. Without them the store would start with empty credentials, so compose
# refuses to render. Generate each with:  openssl rand -hex 16
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Memory ceiling of the store (default 150m). Change it only with the owner's word.
# STORE_MEM_LIMIT=150m

# --- AI features (download_media) ---
# One OpenRouter key powers both:
#   transcription — Whisper Large v3 (download_media transcribe=true)
#   image description — vision model (download_media describe=true)
OPENROUTER_API_KEY=

# Rollback lane. Leave UNSET for normal operation (defaults to openrouter).
# Setting it to groq/openai also requires that vendor's key below.
# AUDIO_PROVIDER=
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Image description model override (any OpenRouter image-input model id).
# VISION_MODEL=openai/gpt-6-luna

# ── Connection watchdog — self-heals a wedged WhatsApp socket ─────────────────
# If the socket stays down (not connected/syncing, and not waiting on a QR scan)
# for this many seconds, the process pushes a priority-5 ntfy and exits, and
# `restart: unless-stopped` brings the container back. 0 turns the watchdog off.
# A malformed value falls back to the default, never to "off".
# WATCHDOG_RESTART_AFTER_S=600
# Self-restarts allowed per rolling 6 h (a ban-risk guard against reconnect
# storms). Once reached it stops exiting and pushes "precisa de você" every
# 30 min while still down. 0 = alert only, never restart.
# WATCHDOG_MAX_RESTARTS=3
